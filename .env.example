# Cynteka API Configuration
# Получите API-токен у администратора Cynteka или в техподдержке:
# Телефон: 8-800-333-84-60
# Email: help@cynteka.ru

CYNTEKA_API_URL=https://api.cynteka.ru
CYNTEKA_API_TOKEN=your_api_token_here

# Telegram Bot Configuration
# 1. Создайте бота через @BotFather в Telegram
# 2. Скопируйте токен и вставьте ниже
# 3. Укажите URL дашборда (где запущен Streamlit)
# 4. Добавьте разрешённые Telegram ID через запятую

TELEGRAM_BOT_TOKEN=your_bot_token_here
WEBAPP_URL=http://13.140.145.240:8501
TELEGRAM_ALLOWED_USERS=639180902

# Development Mode
# Разрешить доступ без авторизации через Telegram (ТОЛЬКО для разработки!)
ALLOW_ANONYMOUS=false
